# Папка, в которой хранятся комиксы
    BASE_DIR = D:\MyDev\main_folder

# Подпапки
    # Папка для оригинала, обязательная
    ORIGINAL = Original
    # Необязательные папки, для текстов, файлов-редакторов изображений
    # Будут созданы в папке комикса (для ярлыков) и в папке части
    ADDITIONAL_FOLDERS = Photoshop, Перевод

# Минимальное количество символов в номере части
    LENGTH_NUMBER = 2

# Удаление файлов сайтов и папок с их данными по окончанию работы
# '0' - ничего не делать; '1' - удалить
    DELETE = 0